# ==========================================================================
# JARVIS environment configuration â€” copy this file to ".env" and fill it in.
# ==========================================================================

# ---- REQUIRED: OpenRouter (the main cloud brain) ---------------------------
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openai/gpt-oss-safeguard-20b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Paths ------------------------------------------------------------------
# Primary working directory. Auto-detected if left blank (handles OneDrive).
# DESKTOP_PATH=
# BROWSER_PROFILE_DIR=
# DOWNLOADS_PATH=
# CACHE_DIR=./data/cache

# ---- Local router model ------------------------------------------------------
# ROUTER_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# ---- Email (only used for the SMTP/IMAP fallback; browser Gmail mode
# ---- uses your logged-in Playwright profile and needs no password) -----------
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# ---- Optional: NewsAPI key (RSS feeds work with NO key) -----------------------
NEWS_API_KEY=

# ---- Voice --------------------------------------------------------------------
# Wake word model shipped with openwakeword. Default: hey_jarvis ("Hey Jarvis").
WAKE_WORD=hey_jarvis
# Any edge-tts voice id. British male = the classic JARVIS sound.
TTS_VOICE=en-GB-RyanNeural
# Set to true to use Edge TTS (online). False = Piper offline only.
# Enable local Qwen command routing and offline conversation fallback.
# Requires torch + transformers and downloads the configured model on first use.
LOCAL_ROUTER_ENABLED=true
OPENROUTER_TIMEOUT=60
OPENROUTER_RETRIES=3

# ---- Optional Colibri local GLM runtime --------------------------------------
# Disabled by default. JARVIS never downloads the ~370 GB model or starts Colibri.
# Only the audited loopback OpenAI-compatible API is supported when explicitly enabled.
COLIBRI_ENABLED=false
COLIBRI_MODE=disabled
COLIBRI_REPOSITORY_URL=https://github.com/JustVugg/colibri.git
COLIBRI_COMMIT=44e489b196c9b7876b3d37a0570ebf1c6f90f54c
COLIBRI_BASE_URL=http://127.0.0.1:8000/v1
COLIBRI_MODEL=glm-5.2-colibri
COLIBRI_TIMEOUT_SECONDS=60

# ---- Optional Hermes orchestration ------------------------------------------
# Remain disabled until a separately installed Hermes instance passes the
# JARVIS structured-protocol and safety validation.
HERMES_ENABLED=false
HERMES_MODE=disabled
HERMES_EXECUTABLE=
HERMES_BASE_URL=
HERMES_MODEL=
HERMES_PROVIDER=openrouter
HERMES_TIMEOUT_SECONDS=120
HERMES_MAX_STEPS=25
HERMES_MAX_RETRIES=2
HERMES_MAX_CONCURRENT_TASKS=2
HERMES_BACKGROUND_TASKS_ENABLED=false
HERMES_SCHEDULING_ENABLED=false
HERMES_LEARNING_ENABLED=false
HERMES_TOOL_ACCESS_MODE=jarvis_registry_only
# Offline fallback bundled with the executable by default.
# PIPER_MODEL=data/piper/en_GB-alan-medium.onnx
VOICE_SPEED=1.0
VOICE_PITCH=0
# faster-whisper size: tiny | base | small | medium  (base = fast, small = better)
WHISPER_MODEL=base
WHISPER_DEVICE=auto
GPU_ENABLED=true

# ---- Behaviour ------------------------------------------------------------------
# AUTO_SEND=true sends WhatsApp replies WITHOUT asking each time (use carefully).
AUTO_SEND=false
# CONFIRM_SENDS=false disables ALL voice confirmations (emails, shutdown, etc).
CONFIRM_SENDS=true
MUSIC_SITE=youtube
MUSIC_SEARCH_SUFFIX=official audio
# How JARVIS addresses you.
OWNER_NAME=sir

# ---- Tuning (rarely changed) ------------------------------------------------------
# ROUTER_MAX_NEW_TOKENS=140
# NEWS_CACHE_MINUTES=15
# CHAT_HISTORY_TURNS=20
# MEMORY_FILE=./data/memory.json
# LOG_LEVEL=INFO
# LISTEN_MAX_SECONDS=20
# WAKE_THRESHOLD=0.5
